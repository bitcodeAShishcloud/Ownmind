# OwnMind configuration
#
# Copy this to .env and fill in the blanks. .env is git ignored and should be
# mode 600. Everything the service needs lives in that one file: the framework
# reads it, systemd reads it, and the npm scripts read it.
#
#   cp .env.example .env && chmod 600 .env
#
# With no configuration at all OwnMind runs, using local text analysis for
# labelling instead of a language model. Location stays empty rather than
# guessing, and the privacy dashboard stays closed rather than open.

NODE_ENV=production
PORT=3000

# Where the SQLite database and uploaded images are written.
OWNMIND_DATA_DIR=/var/lib/ownmind

# Outbound email. Needed for sign up and sign in codes. Unset, the message is
# written to the server log instead, which is fine locally and must be
# configured before launch.
#
# OWNMIND_MAIL_API_KEY=re_...
# OWNMIND_MAIL_ENDPOINT=https://api.resend.com/emails
# OWNMIND_MAIL_FROM=OwnMind <no-reply@yourdomain.com>

# Cloudflare Turnstile, the challenge on sign up and sign in. Unset, OwnMind
# falls back to Cloudflare's public test keys, which accept every submission
# and so protect nothing.
#
# OWNMIND_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# OWNMIND_TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Unlocks /admin/privacy. Unset, the dashboard is closed rather than open.
#
# OWNMIND_ADMIN_TOKEN=

# MaxMind GeoLite2, used to turn a network address into a city, a region and a
# country on this server. The free key is at
# https://www.maxmind.com/en/geolite2/signup and both values are on
# https://www.maxmind.com/en/accounts/current/license-key
#
# npm run fetch-geoip downloads the database to OWNMIND_MAXMIND_DB_PATH and
# writes /etc/GeoIP.conf, because geoipupdate reads that file and nothing else.
#
# OWNMIND_MAXMIND_ACCOUNT_ID=
# OWNMIND_MAXMIND_LICENSE_KEY=
# OWNMIND_MAXMIND_DB_PATH=/var/lib/ownmind/geoip/GeoLite2-City.mmdb

# Labelling with a language model. Any OpenAI compatible endpoint works.
# Leave this unset and OwnMind uses local heuristics only, and nothing you save
# leaves this server.
#
# OWNMIND_AI_API_KEY=sk-...
# OWNMIND_AI_BASE_URL=https://api.openai.com/v1
# OWNMIND_AI_MODEL=gpt-4o-mini

# NODE_ENV is set by the framework, do not set it in .env.local. In production
# it makes session cookies Secure and suppresses the development reset link in
# logs.
# OwnMind configuration
#
# Everything here is optional. With no configuration at all OwnMind runs fully,
# using local text analysis for labelling instead of a language model.

# Where the SQLite database and uploaded images are written.
# Defaults to .data in the project root.
# OWNMIND_DATA_DIR=/var/lib/ownmind

# Labelling with a language model. Any OpenAI compatible endpoint works.
# Leave this unset and OwnMind uses local heuristics only.
#
# OWNMIND_AI_API_KEY=sk-...
# OWNMIND_AI_BASE_URL=https://api.openai.com/v1
# OWNMIND_AI_MODEL=gpt-4o-mini

# Outbound email. Needed for password resets and service notices. Unset, the
# message is written to the server log instead, which is fine locally and must
# be configured before launch.
#
# OWNMIND_MAIL_API_KEY=re_...
# OWNMIND_MAIL_ENDPOINT=https://api.resend.com/emails
# OWNMIND_MAIL_FROM=OwnMind <no-reply@yourdomain.com>

# NODE_ENV is set by the framework, do not set it here. In production it makes
# session cookies Secure and suppresses the development reset link in logs.
